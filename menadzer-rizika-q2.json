[
  {
    $match: {
      anomaly_flag: true,
      alert_sent: true,
      delay_added_hours: { $gt: 0 }
    }
  },
  {
    $lookup: {
      from: "shipments",
      localField: "shipment_id",
      foreignField: "shipment_id",
      as: "shipment"
    }
  },
  {
    $unwind: "$shipment"
  },
  {
    $group: {
      _id: {
        carrier: "$shipment.carrier",
        route: {
          origin: "$shipment.origin_port",
          destination: "$shipment.destination_port"
        },
        status: "$shipment.status"
      },
      broj: {
        $sum: 1
      }
    }
  },
  {
    $sort: {
      broj: -1
    }
  }
]